<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0"
         xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd">

    <!-- Общее задание: сервлет-словарь -->
    <servlet>
        <servlet-name>DictionaryServlet</servlet-name>
        <servlet-class>lab3.server.DictionaryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DictionaryServlet</servlet-name>
        <url-pattern>/DictionaryServlet</url-pattern>
    </servlet-mapping>

    <!-- Вариант 4: сервлет, возвращающий документ Word -->
    <servlet>
        <servlet-name>WordServlet</servlet-name>
        <servlet-class>lab3.server.WordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WordServlet</servlet-name>
        <url-pattern>/WordServlet</url-pattern>
    </servlet-mapping>

    <!-- Стартовая страница приложения -->
    <welcome-file-list>
        <welcome-file>dictionary.html</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
